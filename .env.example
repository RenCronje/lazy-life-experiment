# Local editor/GitHub publisher settings. Copy to .env.local and fill in values.
# Never commit a real token or password.
EDITOR_PASSWORD=choose-a-long-random-password
GITHUB_TOKEN=github_fine_grained_token_with_contents_write
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-repository-name
GITHUB_BRANCH=main
# Optional; repo-relative path. Defaults to site-content.json.
GITHUB_CONTENT_PATH=site-content.json
